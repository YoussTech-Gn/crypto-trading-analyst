# AI Crypto Trading Analyst - Environment Configuration Example
# Safe placeholders only. Do NOT add private exchange API keys or secrets.
# The initial release uses Binance public Spot market data only.

APP_ENV=development
CONFIG_PATH=config/default.yaml

# Database. SQLite needs no setup and is the easiest start:
DATABASE_URL=sqlite:///paper.db
# PostgreSQL (docker compose up -d): set your own password here and in POSTGRES_PASSWORD
# DATABASE_URL=postgresql://analyst:CHANGE_ME@localhost:5432/crypto_trading_analyst
# POSTGRES_PASSWORD=CHANGE_ME

# Binance Public REST API Base URL (no API key or secret required/accepted)
BINANCE_BASE_URL=https://api.binance.com

# FastAPI Backend
API_HOST=127.0.0.1  # this computer only; 0.0.0.0 would expose the API to your whole network
API_PORT=8000

# Next.js Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Outside watcher (ADR-047, optional): a check URL from a service such as healthchecks.io.
# The cycle pings it every hour; the service alerts you when pings stop (computer asleep, off or offline).
# Keep the real URL only in your .env (it is a secret). Must start with https://
# NOTIFY_HEARTBEAT_URL=https://hc-ping.com/your-check-uuid
